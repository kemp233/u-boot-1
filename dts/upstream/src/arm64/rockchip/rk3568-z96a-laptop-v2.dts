// SPDX-License-Identifier: (GPL-2.0+ OR MIT)
/*
 * Sunniwell Z96A RK3568 Laptop V2 — U-Boot DT
 * V2: RK809 + HUSB311 + CN3705
 * Recovery/download key = SARADC (adc-keys), NOT a plain GPIO.
 * Factory U-Boot had adc-keys on saradc ch0 (volume up / recovery).
 * rockchip_dnl_key_pressed() samples saradc ch1 (0..30 = pressed).
 */

/dts-v1/;

#include <dt-bindings/gpio/gpio.h>
#include <dt-bindings/input/input.h>
#include <dt-bindings/pinctrl/rockchip.h>
#include "rk3568.dtsi"

/ {
	model = "Sunniwell Z96A RK3568 Laptop V2";
	compatible = "sunniwell,z96a-rk3568-laptop-v2", "rockchip,rk3568";

	aliases {
		mmc0 = &sdhci;
		mmc1 = &sdmmc0;
		serial2 = &uart2;
		i2c0 = &i2c0;
	};

	chosen {
		stdout-path = "serial2:1500000n8";
	};

	/*
	 * SARADC VREF must be present or probe fails with:
	 *   can't get vref-supply: -2
	 *   rockchip_dnl_key_pressed: adc_channel_single_shot fail!
	 * Use a fixed 1.8V rail (same as other RK3568 boards' vcca_1v8).
	 * Keep always-on/boot-on; do not require full RK809 tree in U-Boot.
	 */
	vcca_1v8: regulator-vcca-1v8 {
		compatible = "regulator-fixed";
		regulator-name = "vcca_1v8";
		regulator-always-on;
		regulator-boot-on;
		regulator-min-microvolt = <1800000>;
		regulator-max-microvolt = <1800000>;
	};

	/* Z96A volume-up key (also Recovery on case silkscreen).
	 * Wiring per Android stock factory DTB (workspace/z96a-extract/
	 * 233-analysis/dts/boot-0.dts): SARADC ch2, keyup range
	 * 1.20..1.40 V, press range 0.14..0.17 V.  rockchip adc-keys
	 * driver supports -min/-max variants of both thresholds.
	 */
	adc-keys {
		compatible = "adc-keys";
		io-channels = <&saradc 2>;
		io-channel-names = "buttons";
		keyup-threshold-microvolt-min = <1200000>;
		keyup-threshold-microvolt-max = <1400000>;
		status = "okay";
		bootph-all;

		/* Factory: label "volume up", ~0.14-0.17 V = pressed */
		vol-up-key {
			label = "volume up";
			linux,code = <KEY_VOLUMEUP>;
			press-threshold-microvolt-min = <140000>;
			press-threshold-microvolt-max = <170000>;
			bootph-all;
		};

		/*
		 * Same electrical key, often silkscreened Recovery on the case.
		 * Keep a recovery-named node for clarity (same ch2 thresholds).
		 */
		button-recovery {
			label = "Recovery";
			linux,code = <KEY_VENDOR>;
			press-threshold-microvolt-min = <140000>;
			press-threshold-microvolt-max = <170000>;
			bootph-all;
		};
	};
};

&uart2 {
	pinctrl-0 = <&uart2m0_xfer>;
	status = "okay";
};

&sdhci {
	bus-width = <8>;
	cap-mmc-highspeed;
	mmc-hs200-1_8v;
	non-removable;
	status = "okay";
};

&sdmmc0 {
	bus-width = <4>;
	cap-sd-highspeed;
	disable-wp;
	status = "okay";
};

/* V2: RK809 + HUSB311 on I2C0 */
&i2c0 {
	status = "okay";
	clock-frequency = <100000>;
};

&saradc {
	vref-supply = <&vcca_1v8>;
	status = "okay";
	bootph-all;
};

&usb_host0_xhci {
	status = "okay";
};

&usb_host1_xhci {
	status = "okay";
};

&usb2phy0 {
	status = "okay";
};

&usb2phy0_host {
	status = "okay";
};

&usb2phy1 {
	status = "okay";
};

&usb2phy1_host {
	status = "okay";
};
